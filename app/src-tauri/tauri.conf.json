{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPTImageStudio",
  "version": "0.1.1",
  "identifier": "com.gptimagestudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GPT 生图工作室",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.github.com; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "GPT 生图工作室",
    "longDescription": "调用 OpenAI 兼容 GPT 生图接口（/images/generations、/images/edits）的本地桌面端，支持多接口分组、文生图、图生图与作品画廊。",
    "copyright": "© 2026 GPT Image Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      },
      "signingIdentity": "-"
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMDlGODZBODYyQTE4ODcKUldTSEdDcUdhdmdKcmlyRTIrOVJveThYN2VzaXJ1aHFjdFc4bC9rRDg1WEl4cVl6UnlLNkswVXEK",
      "endpoints": [
        "https://github.com/dimabehrs538-wq/gpt-image-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
